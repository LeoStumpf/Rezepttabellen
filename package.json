{
  "name": "myrecipetables",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "server"
  ],
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "start": "npm -w server run start",
    "test": "vitest run",
    "check": "tsc -p shared && npm -w web run check && tsc -p server",
    "apk": "npm -w web run build -- --mode android && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4"
  }
}
